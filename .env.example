# Copy this file to .env.local and fill in your keys.

# Stripe (test mode). Create a free test key at:
#   https://dashboard.stripe.com/test/apikeys
# When STRIPE_SECRET_KEY is set, checkout redirects to a real Stripe
# Checkout test session (pay with card 4242 4242 4242 4242, any future
# expiry, any CVC). When it is empty, the store falls back to a simulated
# demo payment so checkout keeps working with zero configuration.
STRIPE_SECRET_KEY=

# Optional: point the catalog at a DummyJSON proxy (server-side only).
# DUMMYJSON_BASE_URL=https://dummyjson.com
